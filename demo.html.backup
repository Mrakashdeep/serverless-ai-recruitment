def lambda_handler(event, context):
    submission = get_submission(submission_id)
    
    prompt = f"""
Based on this resume:
{submission['resume_content']}

For job: {job['job_role']}
Required skills: {job['required_skills']}

Generate 3 coding questions (EASY/MEDIUM/HARD mix).
Return ONLY JSON array:
[{{
  "question_id": "unique_id",
  "title": "brief title",
  "difficulty": "EASY/MEDIUM/HARD",
  "description": "full problem statement",
  "sample_input": "example",
  "expected_output": "example",
  "tags": ["Python", "AWS"]
}}]
"""
    
    questions = call_ollama_and_parse(prompt)
    
    # Save to DynamoDB
    table.update_item(
        Key={"submission_id": submission_id},
        UpdateExpression="SET coding_questions = :qs, #status = :status",
        ExpressionAttributeNames={"#status": "status"},
        ExpressionAttributeValues={
            ":qs": questions,
            ":status": "CODING_READY"
        }
    )`
