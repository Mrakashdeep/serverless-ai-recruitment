<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Serverless AI Recruitment System - Interactive Demo</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes flowPulse {
            0%, 100% { opacity: 0.3; }
            50% { opacity: 1; }
        }
        @keyframes slideIn {
            from { transform: translateX(-20px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        .flow-arrow {
            animation: flowPulse 2s ease-in-out infinite;
        }
        .slide-in {
            animation: slideIn 0.5s ease-out forwards;
        }
        .resource-box {
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .resource-box:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
        .resource-box.active {
            box-shadow: 0 0 0 3px #3b82f6;
            transform: scale(1.05);
        }
        .tooltip {
            position: absolute;
            background: linear-gradient(135deg, #1e40af 0%, #7c3aed 100%);
            color: white;
            padding: 16px 20px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            pointer-events: none;
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            z-index: 1000;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            border: 2px solid rgba(255,255,255,0.2);
            max-width: 300px;
            transform: scale(0.8);
        }
        .tooltip.show {
            opacity: 1;
            transform: scale(1);
        }
        .tooltip::before {
            content: '�';
            margin-right: 8px;
            font-size: 18px;
        }
        .code-panel {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        .code-panel.open {
            max-height: 400px;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-50 to-blue-50 min-h-screen">
    <div id="tooltip" class="tooltip"></div>
    
    <!-- Header -->
    <header class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Serverless AI Recruitment System</h1>
                <p class="text-sm text-gray-600">IIT Patna M.Tech Project - Akashdeep Choudhury (24A07RES24)</p>
            </div>
            <div class="flex gap-4">
                <button onclick="previousStep()" id="prevBtn" class="px-4 py-2 bg-gray-200 hover:bg-gray-300 rounded-lg font-semibold">
                    ← Previous
                </button>
                <button onclick="nextStep()" id="nextBtn" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold">
                    Next →
                </button>
            </div>
        </div>
    </header>

    <!-- Progress Bar -->
    <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="bg-white rounded-lg shadow-sm p-4">
            <div class="flex justify-between mb-2">
                <span class="text-sm font-semibold text-gray-700" id="stepTitle">Step 1 of 7: Job Creation</span>
                <span class="text-sm text-gray-500" id="stepCounter">1/7</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
                <div id="progressBar" class="bg-blue-600 h-2 rounded-full transition-all duration-500" style="width: 14.3%"></div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-6 py-6">
        <div class="grid grid-cols-2 gap-6" id="mainContent">
            <!-- Left Panel: User View -->
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <span class="text-2xl">�</span>
                    User Interface
                </h2>
                <div id="userView" class="min-h-96"></div>
            </div>

            <!-- Right Panel: AWS Backend -->
            <div class="bg-white rounded-lg shadow-lg p-6">
                <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                    <span class="text-2xl">☁️</span>
                    AWS Backend Architecture
                </h2>
                <div id="backendView" class="min-h-96 relative"></div>
                
                <!-- Code Panel (expandable) -->
                <div class="mt-4">
                    <button onclick="toggleCode()" class="text-sm text-blue-600 hover:text-blue-800 font-medium">
                        <span id="codeToggleText">▶ Show Code</span>
                    </button>
                    <div id="codePanel" class="code-panel mt-2">
                        <pre class="bg-gray-900 text-green-400 p-4 rounded-lg text-xs overflow-x-auto"><code id="codeContent"></code></pre>
                    </div>
                </div>
            </div>
        </div>

        <!-- Description Panel -->
        <div class="bg-white rounded-lg shadow-lg p-6 mt-6">
            <h3 class="text-lg font-bold text-gray-900 mb-3">What's Happening?</h3>
            <p id="stepDescription" class="text-gray-700 leading-relaxed"></p>
        </div>
    </main>

    <script>
        let currentStep = 0;
        const totalSteps = 7;

        const steps = [
            {
                title: "Job Creation",
                userView: `
                    <div class="slide-in">
                        <div class="bg-gradient-to-br from-blue-50 to-purple-50 border-2 border-blue-200 rounded-lg p-6 mb-4">
                            <h3 class="text-lg font-bold text-gray-900 mb-4">Create New Job</h3>
                            <div class="space-y-3">
                                <input type="text" value="Senior Python Developer" readonly class="w-full px-3 py-2 border rounded-lg bg-white">
                                <input type="text" value="Python, AWS, FastAPI, Docker" readonly class="w-full px-3 py-2 border rounded-lg bg-white">
                                <textarea readonly class="w-full px-3 py-2 border rounded-lg bg-white h-20">Build scalable serverless applications...</textarea>
                                <button class="w-full bg-blue-600 text-white py-2 rounded-lg font-semibold">Create Job</button>
                            </div>
                        </div>
                        <div class="text-center text-sm text-gray-600">
                            ✓ Recruiter dashboard mockup
                        </div>
                    </div>
                `,
                backendView: `
                    <div class="flex flex-col items-center gap-4 slide-in">
                        <div class="resource-box bg-gradient-to-br from-orange-100 to-orange-200 p-4 rounded-lg border-2 border-orange-300 w-64 active" 
                             onmouseover="showTooltip(event, 'API Gateway receives POST /jobs with JWT token')" 
                             onmouseout="hideTooltip()">
                            <img src="aws-icons/secrets-manager.png" class="w-12 h-12 mx-auto mb-2" alt="secrets-manager">
                            <div class="font-bold text-sm">API Gateway</div>
                            <div class="text-xs text-gray-600">POST /jobs</div>
                        </div>
                        
                        <svg class="flow-arrow" width="2" height="40"><line x1="1" y1="0" x2="1" y2="40" stroke="#3b82f6" stroke-width="2"/></svg>
                        
                        <div class="resource-box bg-gradient-to-br from-purple-100 to-purple-200 p-4 rounded-lg border-2 border-purple-300 w-64"
                             onmouseover="showTooltip(event, 'Ingress Lambda validates and routes requests')"
                             onmouseout="hideTooltip()">
                            <img src="aws-icons/lambda.png" class="w-12 h-12 mx-auto mb-2" alt="lambda">
                            <div class="font-bold text-sm">Ingress Lambda</div>
                            <div class="text-xs text-gray-600">Router (8 endpoints)</div>
                        </div>
                        
                        <svg class="flow-arrow" width="2" height="40"><line x1="1" y1="0" x2="1" y2="40" stroke="#3b82f6" stroke-width="2"/></svg>
                        
                        <div class="resource-box bg-gradient-to-br from-green-100 to-green-200 p-4 rounded-lg border-2 border-green-300 w-64"
                             onmouseover="showTooltip(event, 'Job stored in DynamoDB job-configs table')"
                             onmouseout="hideTooltip()">
                            <img src="aws-icons/secrets-manager.png" class="w-12 h-12 mx-auto mb-2" alt="secrets-manager">
                            <div class="font-bold text-sm">DynamoDB</div>
                            <div class="text-xs text-gray-600">job-configs table</div>
                        </div>
                    </div>
                `,
                description: "Recruiter creates a new job posting via the dashboard. The request goes through API Gateway with JWT authentication, then Ingress Lambda validates and stores it in DynamoDB job-configs table. Custom evaluation prompts are saved for later AI use.",
                code: `# Ingress Lambda - Job Creation Handler
def handle_create_job(event):
    body = json.loads(event["body"])
    table = dynamodb.Table("job-configs")
    
    # Add defaults
    body.setdefault("status", "active")
    body.setdefault("created_at", datetime.now().isoformat())
    
    # Save to DynamoDB
    table.put_item(Item=body)
    
    return {"statusCode": 201, "body": json.dumps({
        "message": "Job created successfully"
    })}`
            },
            {
                title: "Resume Submission",
                userView: `
                    <div class="slide-in">
                        <div class="bg-gradient-to-br from-green-50 to-blue-50 border-2 border-green-200 rounded-lg p-6 mb-4">
                            <h3 class="text-lg font-bold text-gray-900 mb-4">Apply for Senior Python Developer</h3>
                            <div class="space-y-3">
                                <input type="text" value="Akashdeep Choudhury" readonly class="w-full px-3 py-2 border rounded-lg bg-white">
                                <input type="email" value="akashdeep@example.com" readonly class="w-full px-3 py-2 border rounded-lg bg-white">
                                <div class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center">
                                    <div class="text-3xl mb-2">�</div>
                                    <div class="text-sm text-gray-600">resume.pdf uploaded</div>
                                </div>
                                <button class="w-full bg-green-600 text-white py-2 rounded-lg font-semibold">Submit Application</button>
                            </div>
                        </div>
                    </div>
                `,
                backendView: `
                    <div class="flex flex-col items-center gap-3 slide-in">
                        <div class="resource-box bg-orange-100 p-3 rounded-lg border-2 border-orange-300 w-56 text-center">
                            <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                            <div class="font-bold text-xs">API Gateway</div>
                        </div>
                        <svg class="flow-arrow" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#3b82f6" stroke-width="2"/></svg>
                        <div class="resource-box bg-purple-100 p-3 rounded-lg border-2 border-purple-300 w-56 text-center active">
                            <img src="aws-icons/lambda.png" class="w-8 h-8 mx-auto" alt="lambda">
                            <div class="font-bold text-xs">Ingress Lambda</div>
                        </div>
                        <div class="flex gap-4">
                            <div>
                                <svg class="flow-arrow" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#3b82f6" stroke-width="2"/></svg>
                                <div class="resource-box bg-yellow-100 p-3 rounded-lg border-2 border-yellow-300 w-24 text-center text-xs"
                                     onmouseover="showTooltip(event, 'Resume stored in S3 bucket')" onmouseout="hideTooltip()">
                                    <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                                    <div class="font-bold">S3</div>
                                </div>
                            </div>
                            <div>
                                <svg class="flow-arrow" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#3b82f6" stroke-width="2"/></svg>
                                <div class="resource-box bg-green-100 p-3 rounded-lg border-2 border-green-300 w-24 text-center text-xs"
                                     onmouseover="showTooltip(event, 'Submission record in DynamoDB')" onmouseout="hideTooltip()">
                                    <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                                    <div class="font-bold">DDB</div>
                                </div>
                            </div>
                            <div>
                                <svg class="flow-arrow" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#3b82f6" stroke-width="2"/></svg>
                                <div class="resource-box bg-blue-100 p-3 rounded-lg border-2 border-blue-300 w-24 text-center text-xs"
                                     onmouseover="showTooltip(event, 'Message sent to Resume SQS queue')" onmouseout="hideTooltip()">
                                    <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                                    <div class="font-bold">SQS</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `,
                description: "Candidate uploads resume and submits application. The resume text is stored in S3, a submission record is created in DynamoDB with status 'RESUME_PENDING', and a message is sent to the Resume SQS queue to trigger AI evaluation.",
                code: `# Ingress Lambda - Submit Handler
def handle_submit(event):
    body = json.loads(event["body"])
    submission_id = str(uuid.uuid4())
    
    # Store resume in S3
    s3.put_object(
        Bucket=S3_BUCKET,
        Key=f"resumes/{submission_id}.txt",
        Body=body["resume_content"]
    )
    
    # Create DynamoDB record
    submissions_table.put_item(Item={
        "submission_id": submission_id,
        "candidate_name": body["candidate_name"],
        "email": body["email"],
        "status": "RESUME_PENDING",
        "submitted_at": datetime.now().isoformat()
    })
    
    # Send to SQS
    sqs.send_message(
        QueueUrl=RESUME_QUEUE_URL,
        MessageBody=json.dumps({
            "submission_id": submission_id,
            "resume_s3_key": f"resumes/{submission_id}.txt"
        })
    )
    
    return {"statusCode": 200, "body": json.dumps({
        "submission_id": submission_id
    })}`
            },
            {
                title: "AI Resume Evaluation",
                userView: `
                    <div class="slide-in">
                        <div class="bg-gradient-to-br from-purple-50 to-pink-50 border-2 border-purple-200 rounded-lg p-6">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
                                <h3 class="text-lg font-bold text-gray-900">Evaluating Resume...</h3>
                            </div>
                            <div class="space-y-2 text-sm text-gray-600">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                                    <span>Resume uploaded</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 bg-yellow-500 rounded-full animate-pulse"></div>
                                    <span>AI analyzing skills and experience...</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 bg-gray-300 rounded-full"></div>
                                    <span>Pending recruiter review</span>
                                </div>
                            </div>
                            <div class="mt-4 text-center text-xs text-gray-500">
                                Typical evaluation time: 30-45 seconds
                            </div>
                        </div>
                    </div>
                `,
                backendView: `
                    <div class="flex flex-col items-center gap-3 slide-in">
                        <div class="resource-box bg-blue-100 p-3 rounded-lg border-2 border-blue-300 w-56 text-center active"
                             onmouseover="showTooltip(event, 'SQS triggers Lambda on new message')" onmouseout="hideTooltip()">
                            <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                            <div class="font-bold text-xs">Resume Queue (SQS)</div>
                        </div>
                        <svg class="flow-arrow" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#3b82f6" stroke-width="2"/></svg>
                        <div class="resource-box bg-purple-100 p-4 rounded-lg border-2 border-purple-300 w-64 text-center active"
                             onmouseover="showTooltip(event, 'Resume Eval Lambda processes evaluation')" onmouseout="hideTooltip()">
                            <img src="aws-icons/lambda.png" class="w-12 h-12 mx-auto mb-2" alt="lambda">
                            <div class="font-bold">Resume Eval Lambda</div>
                            <div class="text-xs text-gray-600 mt-1">Timeout: 300s</div>
                        </div>
                        <svg class="flow-arrow" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#3b82f6" stroke-width="2"/></svg>
                        <div class="resource-box bg-gradient-to-br from-indigo-100 to-purple-200 p-4 rounded-lg border-2 border-indigo-300 w-64 text-center"
                             onmouseover="showTooltip(event, 'Ollama (Llama 3 8B) via ngrok tunnel')" onmouseout="hideTooltip()">
                            <img src="aws-icons/secrets-manager.png" class="w-12 h-12 mx-auto mb-2" alt="secrets-manager">
                            <div class="font-bold">Ollama LLM</div>
                            <div class="text-xs text-gray-600">Meta-Llama-3-8B</div>
                        </div>
                        <svg class="flow-arrow" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#3b82f6" stroke-width="2"/></svg>
                        <div class="resource-box bg-green-100 p-3 rounded-lg border-2 border-green-300 w-56 text-center"
                             onmouseover="showTooltip(event, 'Score and verdict saved to DynamoDB')" onmouseout="hideTooltip()">
                            <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                            <div class="font-bold text-xs">DynamoDB Update</div>
                            <div class="text-xs text-gray-600">status: RESUME_EVALUATED</div>
                        </div>
                    </div>
                `,
                description: "SQS triggers Resume Eval Lambda which fetches the resume from S3 and sends it to Ollama (Llama 3 LLM) via ngrok tunnel. The AI analyzes skills, experience, and job fit using a two-layer prompt (custom criteria + fixed JSON structure). Results (score 0-100, verdict SHORTLIST/REJECT, summary) are saved to DynamoDB.",
                code: `# Resume Eval Lambda
def lambda_handler(event, context):
    for record in event['Records']:
        data = json.loads(record['body'])
        submission_id = data['submission_id']
        
        # Fetch resume from S3
        resume = s3.get_object(
            Bucket=S3_BUCKET,
            Key=data['resume_s3_key']
        )['Body'].read().decode()
        
        # Two-layer prompt
        prompt = f"""
{job_config['custom_instructions']}

Evaluate this resume and return ONLY JSON:
{{
  "score": 0-100,
  "verdict": "SHORTLIST" or "REJECT",
  "summary": "brief explanation"
}}

Resume: {resume}
"""
        
        # Call Ollama
        response = requests.post(
            f"{OLLAMA_URL}/api/generate",
            json={"model": "llama3", "prompt": prompt}
        )
        
        result = parse_llm_response(response.json())
        
        # Update DynamoDB
        table.update_item(
            Key={"submission_id": submission_id},
            UpdateExpression="SET resume_score = :score, resume_verdict = :verdict, status = :status",
            ExpressionAttributeValues={
                ":score": result["score"],
                ":verdict": result["verdict"],
                ":status": "RESUME_EVALUATED"
            }
        )`
            },
            {
                title: "Recruiter Decision",
                userView: `
                    <div class="slide-in">
                        <div class="bg-white border-2 border-blue-200 rounded-lg p-6">
                            <h3 class="text-lg font-bold text-gray-900 mb-4">Resume Evaluation Complete</h3>
                            <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-lg p-4 mb-4">
                                <div class="flex justify-between items-center mb-2">
                                    <span class="font-semibold">Score:</span>
                                    <span class="text-3xl font-bold text-green-600">85/100</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="font-semibold">Verdict:</span>
                                    <span class="px-3 py-1 bg-green-200 text-green-800 rounded-full font-bold">SHORTLIST</span>
                                </div>
                                <p class="text-sm text-gray-700 mt-3">Strong candidate with 4+ years Python experience, AWS serverless expertise, and proven cost optimization skills.</p>
                            </div>
                            <div class="flex gap-3">
                                <button class="flex-1 bg-green-600 text-white py-3 rounded-lg font-semibold">✓ Advance to Coding</button>
                                <button class="flex-1 bg-red-600 text-white py-3 rounded-lg font-semibold">✗ Reject</button>
                            </div>
                        </div>
                    </div>
                `,
                backendView: `
                    <div class="flex flex-col items-center gap-3 slide-in">
                        <div class="resource-box bg-orange-100 p-3 rounded-lg border-2 border-orange-300 w-56 text-center">
                            <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                            <div class="font-bold text-xs">API Gateway</div>
                            <div class="text-xs text-gray-600">POST /decision</div>
                        </div>
                        <svg class="flow-arrow" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#3b82f6" stroke-width="2"/></svg>
                        <div class="resource-box bg-purple-100 p-3 rounded-lg border-2 border-purple-300 w-56 text-center active"
                             onmouseover="showTooltip(event, 'Ingress processes recruiter decision')" onmouseout="hideTooltip()">
                            <img src="aws-icons/lambda.png" class="w-8 h-8 mx-auto" alt="lambda">
                            <div class="font-bold text-xs">Ingress Lambda</div>
                        </div>
                        <div class="flex gap-4 mt-3">
                            <div class="text-center">
                                <div class="text-sm font-semibold mb-2">If ADVANCE:</div>
                                <svg class="flow-arrow mx-auto" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#10b981" stroke-width="2"/></svg>
                                <div class="resource-box bg-blue-100 p-3 rounded-lg border-2 border-blue-300 w-40 text-xs"
                                     onmouseover="showTooltip(event, 'Trigger question generation')" onmouseout="hideTooltip()">
                                    <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                                    <div class="font-bold">Question Queue</div>
                                </div>
                            </div>
                            <div class="text-center">
                                <div class="text-sm font-semibold mb-2">If REJECT:</div>
                                <svg class="flow-arrow mx-auto" width="2" height="30"><line x1="1" y1="0" x2="1" y2="30" stroke="#ef4444" stroke-width="2"/></svg>
                                <div class="resource-box bg-red-100 p-3 rounded-lg border-2 border-red-300 w-40 text-xs"
                                     onmouseover="showTooltip(event, 'Set final_status = REJECTED')" onmouseout="hideTooltip()">
                                    <img src="aws-icons/secrets-manager.png" class="w-8 h-8 mx-auto" alt="secrets-manager">
                                    <div class="font-bold">DynamoDB</div>
                                    <div class="text-xs">final_status</div>
                                </div>
                            </div>
                        </div>
                    </div>
                `,
                description: "Recruiter reviews the AI evaluation and makes a decision. If ADVANCE, a message is sent to Question SQS queue to generate coding questions. If REJECT, the submission is marked as final_status=REJECTED. This human-in-the-loop gate prevents wasted compute and maintains quality control.",
                code: `# Ingress Lambda - Decision Handler
def handle_decision(event):
    body = json.loads(event["body"])
    submission_id = body["submission_id"]
    decision = body["decision"]  # "ADVANCE" or "REJECT"
    
    if decision == "ADVANCE":
        # Send to question generation queue
        sqs.send_message(
            QueueUrl=QUESTION_QUEUE_URL,
            MessageBody=json.dumps({
                "submission_id": submission_id
            })
        )
        
        # Update status
        table.update_item(
            Key={"submission_id": submission_id},
            UpdateExpression="SET #status = :status",
            ExpressionAttributeNames={"#status": "status"},
            ExpressionAttributeValues={":status": "CODING_PENDING"}
        )
    else:
        # Mark as rejected
        table.update_item(
            Key={"submission_id": submission_id},
            UpdateExpression="SET final_status = :status",
            ExpressionAttributeValues={":status": "REJECTED"}
        )
    
    return {"statusCode": 200}`
