                description: "Candidate completes 3 coding questions within 30 minutes. Code is stored in S3 and sent to Code SQS queue. Code Eval Lambda evaluates correctness, code quality, and best practices using Ollama. Final decision is computed: avg_score=(resume+code)/2, final_status=SHORTLISTED if avg≥60 AND code_verdict=PASS AND resume_verdict=SHORTLIST.",
                code: `# Code Eval Lambda
def lambda_handler(event, context):
    # Fetch code from S3
    code = s3.get_object(...)['Body'].read()
    
    # Evaluate with Ollama
    result = evaluate_code_with_llm(code, questions)
    
    # 5-strategy robust JSON parsing
    parsed = parse_llm_response_with_fallback(result)
    
    # Compute final decision
    avg_score = (resume_score + parsed['score']) / 2
    final_status = (
        "SHORTLISTED" 
        if avg_score >= 60 
           and parsed['verdict'] == "PASS" 
           and resume_verdict == "SHORTLIST"
        else "REJECTED"
    )
    
    # Update DynamoDB
    table.update_item(
        Key={"submission_id": submission_id},
        UpdateExpression="SET code_score = :cs, final_status = :fs, #status = :st",
        ExpressionAttributeValues={
            ":cs": parsed['score'],
            ":fs": final_status,
            ":st": "COMPLETED"
        }
    )`
